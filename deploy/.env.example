# ==========================================
# StaffDeck Docker 部署环境变量配置
# ==========================================

# 1. 宿主机服务端口映射 (默认 5173，若被占用可修改为 8080 等)
STAFFDECK_PORT=5173

# 2. 核心系统安全秘钥 (生产环境务必替换为 32 位以上随机字符串)
APP_SECRET=replace-this-with-a-very-long-random-secret-key-32chars

# 3. 初始大模型接口配置 (OpenAI 兼容格式)
# 支持 DeepSeek, OpenAI, Moonshot, 阿里通义, 本地 Ollama/vLLM 等
DEMO_MODEL_BASE_URL=https://api.openai.com/v1
DEMO_MODEL_NAME=gpt-4o
DEMO_MODEL_API_KEY=sk-your-model-api-key

# 4. 深度思考 / Reasoning 模型模式设置 (可选，如 deepseek-reasoner)
MODEL_THINKING_MODE=
MODEL_THINKING_MODELS=

# 5. 跨域与网络访问设置
# CORS 允许域列表，生产环境可设置为你的域名（例如 https://staff.yourdomain.com）
CORS_ORIGINS=*

# 工具与回调的基础 URL (容器内部默认使用 http://127.0.0.1:5173)
TOOL_BASE_URL=http://localhost:5173

# 公网对外访问 URL (配置 Nginx / 域名反向代理时填写，例如 https://staff.yourdomain.com)
STAFFDECK_PUBLIC_URL=

# 6. 企业通讯渠道集成 (可选，启动后也可在网页后台配置)
# 飞书官方 CLI 集成开关 (默认开启)
LARK_CLI_ENABLED=true
CHANNEL_SECRET=
